{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "AI文旅",
        "enablePullDownRefresh": false,
        "backgroundColor": "#f5f7fa"
      }
    },
    {
      "path": "pages/list/list",
      "style": {
        "navigationBarTitleText": "精选作品",
        "enablePullDownRefresh": true,
        "backgroundColor": "#f5f7fa"
      }
    },
    {
      "path": "pages/detail/detail",
      "style": {
        "navigationBarTitleText": "作品详情",
        "enablePullDownRefresh": false,
        "backgroundColor": "#ffffff"
      }
    },
    {
      "path": "pages/inspiration/inspiration",
      "style": {
        "navigationBarTitleText": "灵感库",
        "enablePullDownRefresh": true,
        "backgroundColor": "#f5f7fa"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "个人中心",
        "enablePullDownRefresh": false,
        "backgroundColor": "#ffffff"
      }
    },
    {
      "path": "pages/activity/activity",
      "style": {
        "navigationBarTitleText": "活动",
        "enablePullDownRefresh": true,
        "backgroundColor": "#f5f7fa"
      }
    },
    {
      "path": "pages/contest/apply",
      "style": {
        "navigationBarTitleText": "大赛报名",
        "enablePullDownRefresh": false,
        "backgroundColor": "#ffffff"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "AI文旅",
    "navigationBarBackgroundColor": "#1890ff",
    "backgroundColor": "#f5f7fa",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#1890ff",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/list/list",
        "text": "精选作品",
        "iconPath": "static/tabbar/work.png",
        "selectedIconPath": "static/tabbar/work-active.png"
      },
      {
        "pagePath": "pages/inspiration/inspiration",
        "text": "灵感库",
        "iconPath": "static/tabbar/inspiration.png",
        "selectedIconPath": "static/tabbar/inspiration-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "个人中心",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  },
  "miniProgram": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "enhance": true
    },
    "usingComponents": true
  },
  "style": "v2",
  "condition": {}
}
